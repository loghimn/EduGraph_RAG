# Copy outside the Git checkout, e.g. C:/edugraph-secrets/production.env.
# Replace every CHANGE_ME. Never commit the filled file.
# Lowercase GitHub owners. The frontend owner can differ from the backend owner.
REGISTRY_PREFIX=ghcr.io/CHANGE_ME/edugraph
FRONTEND_IMAGE=ghcr.io/CHANGE_ME/edugraph/frontend
BACKEND_TAG=sha-CHANGE_ME
FRONTEND_TAG=sha-CHANGE_ME

# Managed PostgreSQL/Neo4j/Supabase; localhost inside a container is that container.
# If a database runs on this Windows host, use host.docker.internal instead.
DB_URL=jdbc:postgresql://CHANGE_ME:5432/postgres?sslmode=require
DB_USERNAME=CHANGE_ME
DB_PASSWORD='CHANGE_ME'
# Existing project uses Hibernate update + an idempotent schema upgrade.
# Back up DB before each release; use validate only after creating the schema.
DB_DDL_AUTO=update
NEO4J_URI=neo4j+s://CHANGE_ME.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD='CHANGE_ME'
SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_SECRET_KEY='CHANGE_ME'
SUPABASE_STORAGE_BUCKET=course-materials

# JWT_SECRET: Base64 of at least 32 random bytes; shared by Java services.
JWT_SECRET='CHANGE_ME'
AI_CORE_INTERNAL_KEY='CHANGE_ME'
OPENAI_API_KEY='CHANGE_ME'
GEMINI_API_KEY=''
MODEL_MAIN=gpt-5.4-mini
MODEL_FALLBACK=gemini-2.5-flash
EMBED_BATCH_SIZE=1

GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET='CHANGE_ME'
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD='CHANGE_ME'
MAIL_FROM=CHANGE_ME

# Set only if using the tunnel profile. Route the public hostname to http://frontend:80.
CLOUDFLARE_TUNNEL_TOKEN=''
